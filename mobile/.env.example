# Copy to .env and restart `npx expo start` after changing it.

# Local emulator (default project "demo-sushi", no real Firebase account needed).
# iOS Simulator: 127.0.0.1. Physical phone: your computer's LAN IP, e.g. 192.168.1.20
# (the phone and computer must be on the same Wi-Fi). Leave empty to use a real project.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Real Firebase project (Project settings > Your apps > Web app config).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-sushi
EXPO_PUBLIC_FIREBASE_APP_ID=
