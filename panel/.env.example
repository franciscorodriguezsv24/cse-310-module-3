# Copy to .env.local and fill in from Firebase console > Project settings > Your apps (web app).
# With no .env file at all, the panel uses the local emulators and the "demo-sushi" project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set to 127.0.0.1 to use the emulators with the project above; leave empty for the real project.
VITE_FIREBASE_EMULATOR_HOST=
