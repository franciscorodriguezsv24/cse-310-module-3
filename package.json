{
  "name": "sushi-cloud-catalog",
  "private": true,
  "type": "module",
  "scripts": {
    "emulators": "firebase emulators:start --import=.emulator-data --export-on-exit",
    "seed": "node seed/seed.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run\"",
    "deploy:rules": "firebase deploy --only firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.33.0",
    "vitest": "^5.0.4"
  }
}
