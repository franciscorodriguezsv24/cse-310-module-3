rules_version = '2';

// Public read for the catalog; only staff can write. A user is staff when a document
// with their uid exists in /staff. Staff documents are created with the Admin SDK
// (seed script) or the Firebase console, never from a client.
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function validProduct(data) {
      return data.keys().hasAll(['categoryId', 'name', 'basePrice', 'availableAt', 'optionGroups'])
        && isNonEmptyString(data.name)
        && isNonEmptyString(data.categoryId)
        && exists(/databases/$(database)/documents/categories/$(data.categoryId))
        && data.basePrice is int && data.basePrice >= 0
        && data.availableAt is list
        && data.optionGroups is list;
    }

    function validBranch(data) {
      return isNonEmptyString(data.name)
        && isNonEmptyString(data.whatsapp)
        && data.latitude is number && data.longitude is number;
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /branches/{branchId} {
      allow read: if true;
      allow create, update: if isStaff() && validBranch(request.resource.data);
      allow delete: if isStaff();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isStaff() && validProduct(request.resource.data);
      allow delete: if isStaff();
    }

    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
